<!DOCTYPE html>
<html>
<head>
  <title>The Chain</title>
  <style>
    body {
      background: black;
      color: white;
      font-family: Arial;
      text-align: center;
      margin: 0;
      padding: 40px;
    }

    .header {
      font-size: 40px;
      margin-bottom: 20px;
      letter-spacing: 2px;
    }

    .chain {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 30px 0;
      flex-wrap: wrap;
    }

    .block {
      width: 40px;
      height: 40px;
      background: #222;
      border: 1px solid #555;
    }

    .box {
      background: #111;
      padding: 20px;
      margin: 20px auto;
      width: 300px;
      border-radius: 10px;
      border: 1px solid #333;
    }
  </style>
</head>

<body>

<div class="header">🔗 THE CHAIN 🔗</div>

<div class="chain">
  <div class="block"></div>
</div>

<div class="box">
  <h3>User Dashboard</h3>
  <p>Status: Active</p>
  <p>No assignment yet</p>
</div>

</body>
</html>
